# Copy this file to ../CspoE.conf, set all required values, then chmod 600.

BLOCKFROST_PROJECT_ID=
BECH32_POOL_ID=
POOL_TICKER=YOUR_POOL
# First ACTIVE pool epoch, normally registration epoch + 2.
POOL_FIRST_EPOCH=0
CARDANO_NETWORK=mainnet

BLOCKFROST_PAGE_SIZE=100
BLOCKFROST_DAILY_BUDGET=45000
BLOCKFROST_QUOTA_RESERVE=2000
BLOCKFROST_AUTO_PAUSE=1
API_MAX_PAGES=10000
PRUNE_NB=10
# Optional. Missing, empty, or [] means no operator-defined bonuses.
AWARDS_FILE=
CSPOE_KOIOS_BASE=https://api.koios.rest/api/v1
CSPOE_STRICT_SECONDARY_CHECK=0
CSPOE_POOLDATA_AUTO_EXPORT=1

CSPOE_MYSQL_AUTO_SYNC=0
CSPOE_MYSQL_LEGACY_COMPAT=0
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=cspoe
MYSQL_USER=cspoe
MYSQL_PASSWORD=

CSPOE_TELEGRAM_ENABLED=0
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ADMIN_CHAT_ID=
CSPOE_DREP_ID=
CSPOE_TELEGRAM_DREP_ENABLED=0
CSPOE_TELEGRAM_BLOCKS_ENABLED=0
CSPOE_TELEGRAM_STAKE_WATCHER_ENABLED=0
CSPOE_TELEGRAM_DELEGATOR_EVENTS_ENABLED=1
CSPOE_TELEGRAM_POOL_STAKE_EVENTS_ENABLED=1
CSPOE_TELEGRAM_STAKE_GROUP_EVENTS_ENABLED=1
CSPOE_TELEGRAM_INTERACTIVE_ENABLED=0
CSPOE_TELEGRAM_ADMIN_ENABLED=0
CSPOE_TELEGRAM_REQUIRE_OWNERSHIP_VERIFICATION=1
CSPOE_TELEGRAM_CIP8_CHALLENGE_TTL_SECONDS=600
CSPOE_TELEGRAM_STAKE_THRESHOLD_ADA=0
CSPOE_DELEGATOR_CHANGE_THRESHOLD_ADA=100
CSPOE_POOL_STAKE_CHANGE_THRESHOLD_ADA=1000
CSPOE_STAKE_GROUP_TOLERANCE_ADA=10
CSPOE_STAKE_GROUP_MAX_ITEMS=8
CSPOE_STAKE_WATCHER_MAX_PAGES=100
CSPOE_STAKE_ADDRESS_TRANSFER_ENABLED=1
CSPOE_STAKE_ADDRESS_TRANSFER_WINDOW_MINUTES=180
CSPOE_STAKE_ADDRESS_TRANSFER_TOLERANCE_ADA=5
CSPOE_TELEGRAM_SUBSCRIBERS_DB=

CSPOE_CIP8_VERIFY_BACKEND=cardano-signer
CSPOE_CARDANO_SIGNER=/usr/local/bin/cardano-signer
CSPOE_CARDANO_SIGNER_REQUIRED_VERSION=1.35.0

CSPOE_HEALTH_EXTERNAL_FAILURES=3
CSPOE_HEALTH_SYSTEMD_FAILURES=1
CSPOE_HEALTH_REWARD_FAILURES=2
CSPOE_HEALTH_FINALIZATION_LAG_MAX=1
CSPOE_HEALTH_CHAIN_EPOCH_LAG_MAX=1
CSPOE_HEALTH_REWARD_LAG_MAX=2

CSPOE_INSTALL_DIR=/opt/cspoe
CSPOE_SERVICE_USER=cspoe
CSPOE_SERVICE_GROUP=cspoe
CSPOE_INSTALL_MYSQL=0
CSPOE_INSTALL_PHP=0
CSPOE_WEB_DIR=/var/www/html/cspoe
CSPOE_ENABLE_SYSTEMD=1
